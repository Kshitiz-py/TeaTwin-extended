# Ollama Cloud API — copy this file to .env and fill in your real key
# WARNING: .env contains secrets — never commit it to git!
#
# ── Multi-Provider LLM Pre-Configuration (auto-connect on startup) ──
# If LLM_PROVIDER is set, the agent auto-configures at boot.
# Provider options (api_style): openai · azure · anthropic · google · ollama · openrouter · deepseek · custom
LLM_PROVIDER=ollama
LLM_HOST=https://ollama.com
LLM_API_KEY=sk-your-cloud-api-key-here
LLM_CHAT_MODEL=qwen3.5:397b-cloud
LLM_EMBED_MODEL=
LLM_EMBED_PROVIDER=
LLM_EMBED_HOST=
LLM_EMBED_API_KEY=

# Disable auto-indexing on startup if you pre-built embeddings
# AUTO_INDEX_ON_STARTUP=0
